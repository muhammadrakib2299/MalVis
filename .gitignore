# --- Environment ----------------------------------------------------------
.env
.env.*
!.env.example
!.env*.example
!.env.*.example

# --- Model artifacts and datasets -----------------------------------------
# Pickles and trained models live outside git (release assets / object store)
artifacts/*
!artifacts/.gitkeep
!artifacts/MANIFEST.example.json
*.pkl
*.joblib
*.h5
*.onnx
*.pt
*.pth

# Datasets are too large and often license-restricted
datasets/
data/raw/
data/interim/
data/processed/

# --- IDEs and editors -----------------------------------------------------
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp
*.swo

# --- Claude Code local config (per-project, machine-local) ---------------
.claude/

# --- OS noise -------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Logs and runtime ----------------------------------------------------
*.log
logs/
tmp/
*.pid

# --- Docker --------------------------------------------------------------
.docker/
*.local.yml

# --- Sample binaries (uploaded by users locally during dev) -------------
backend/uploads/
backend/scratch/
