# MalVis backend environment template — copy to .env and fill in real values.
# Never commit a real .env. See .gitignore.

# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
ENVIRONMENT=development            # development | staging | production

# --- Security -------------------------------------------------------------
# Comma-separated list of origins allowed for CORS. Lock this down in prod.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Maximum upload size in bytes (10 MB).
MAX_UPLOAD_BYTES=10485760

# Per-IP rate limits (slowapi syntax).
RATE_LIMIT_SCAN=10/minute
RATE_LIMIT_GLOBAL=100/day

# --- Models ---------------------------------------------------------------
# Path to the signed manifest. The loader refuses any pickle not listed here.
MODEL_MANIFEST_PATH=../artifacts/MANIFEST.json
ARTIFACTS_DIR=../artifacts

# Set to "1" to load the mock registry instead of real pickles
# (useful in CI and before real artifacts are wired up).
USE_MOCK_MODELS=1

# --- Caching --------------------------------------------------------------
HASH_CACHE_MAX_ENTRIES=1000
HASH_CACHE_TTL_SECONDS=3600
