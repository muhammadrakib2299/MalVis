# MalVis docker-compose env. Copy to `.env` for local use.
# These are read by docker-compose itself (variable substitution),
# not by the running services — service env vars are set in the
# `environment:` block of docker-compose.yml.

# Public origin the proxy listens on. Locally http://localhost:8080;
# in production set to https://malvis.devrakib.com (CORS allowlist
# follows this).
PUBLIC_ORIGIN=http://localhost:8080
PROXY_HTTP_PORT=8080

# Frontend NEXT_PUBLIC_API_BASE. Default `/api` keeps the frontend on
# the same origin via the proxy — no CORS preflight, simpler ops.
NEXT_PUBLIC_API_BASE=/api

# Backend
ENVIRONMENT=production
LOG_LEVEL=info
USE_MOCK_MODELS=true
